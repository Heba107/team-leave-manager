# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings → API). The publishable/anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email notifications via Resend (https://resend.com). Leave empty to disable emails.
RESEND_API_KEY=
# Sender, e.g. "Team Leave <leave@yourcompany.com>" (domain must be verified in Resend).
NOTIFY_FROM_EMAIL=
# Public URL used in email links (defaults to the URL the app is served from).
APP_URL=

# Optional, local testing only: lets the end-to-end test create/delete test users.
# SECRET — server-side only, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
