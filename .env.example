# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Project Settings → API). The publishable/anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email notifications — set ONE of these. Leave both empty to disable emails.
# a) SMTP via Nodemailer, e.g. an Office 365 mailbox:
#    SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_USER=leave@aman.eg  SMTP_PASS=…
#    (SMTP AUTH must be enabled for that mailbox in Microsoft 365.)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# b) Resend (https://resend.com):
RESEND_API_KEY=
# Sender, e.g. "Team Leave <leave@aman.eg>". With SMTP it defaults to SMTP_USER;
# with Resend the domain must be verified there.
NOTIFY_FROM_EMAIL=
# Public URL used in email links (defaults to the URL the app is served from).
APP_URL=

# Secret (service_role) key: Project Settings → API Keys. Used by /api/signup to create
# already-confirmed accounts (no confirmation email). SECRET — server-side only,
# never prefix with NEXT_PUBLIC_. Required for sign-up; set it on Vercel as well.
SUPABASE_SERVICE_ROLE_KEY=
